# Copy to .env.local and fill in from Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# These web values are not secret (they identify the project, they do not grant
# access; the security rules do that), but keep real values out of screenshots anyway.
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=purbosuri.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=purbosuri
VITE_FIREBASE_APP_ID=REPLACE_ME
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
