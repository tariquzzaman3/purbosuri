rules_version = '2';

// Purbosuri Firestore security rules.
//
// Everything lives under /trees/{treeId}. Access is decided by the caller's
// membership document at /trees/{treeId}/members/{uid}. A user who has no
// membership document in a tree can read and write nothing in it.
//
// Roles: owner > reviewer > contributor > viewer
//   viewer       reads only
//   contributor  adds people, relationships, memories, media records,
//                proposals, comments and votes. Cannot edit or delete
//                existing people/relationships (must propose a change).
//   reviewer     edits records and decides proposals (not their own)
//   owner        everything a reviewer can, plus manages members
//
// No Cloud Functions are used (they need a paid plan), so these rules are
// the only enforcement layer. Anything not matched below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    // Signed in. Someone who signed up with email and password must have verified the
    // email first; Google and other providers have verified it already.
    function signedIn() {
      return request.auth != null
        && !(request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password'
             && request.auth.token.get('email_verified', false) != true);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberDoc(treeId, uid) {
      return /databases/$(database)/documents/trees/$(treeId)/members/$(uid);
    }

    function isMember(treeId) {
      return signedIn() && exists(memberDoc(treeId, request.auth.uid));
    }

    function myRole(treeId) {
      return get(memberDoc(treeId, request.auth.uid)).data.role;
    }

    function isOwner(treeId) {
      return isMember(treeId) && myRole(treeId) == 'owner';
    }

    function isReviewer(treeId) {
      return isMember(treeId) && myRole(treeId) in ['owner', 'reviewer'];
    }

    function canContribute(treeId) {
      return isMember(treeId) && myRole(treeId) in ['owner', 'reviewer', 'contributor'];
    }

    // Optional-field validators: a missing field is fine, a wrong one is not.
    function optString(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    function optList(d, k, max) {
      return !(k in d) || (d[k] is list && d[k].size() <= max);
    }

    function optMap(d, k) {
      return !(k in d) || d[k] is map;
    }

    function optStamp(d) {
      return !('updatedAt' in d) || d.updatedAt == request.time;
    }

    // ---------- users (private profile, only the user) ----------

    function validUser(d) {
      return d.keys().hasOnly(['displayName', 'photoUrl', 'language', 'createdAt'])
        && d.keys().hasAll(['displayName', 'createdAt'])
        && d.displayName is string
        && d.displayName.size() > 0
        && d.displayName.size() <= 100
        && optString(d, 'photoUrl', 500)
        && (!('language' in d) || d.language in ['bn', 'en']);
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid)
        && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSelf(uid);
    }

    // ---------- my trees (a private list of the trees I belong to) ----------
    // Firestore cannot search trees by membership, so each person keeps their
    // own list. They can only add a tree to it if they really are a member.

    // One person can belong to at most five trees, created or joined. Each tree in the list
    // must take one of five numbered slots, and a slot can only be freed together with its
    // list entry, so the limit holds even without a server program to count.

    function slotDoc(uid, n) {
      return /databases/$(database)/documents/users/$(uid)/slots/$(string(n));
    }

    function validSlot(n) {
      return n is int && n >= 1 && n <= 5;
    }

    match /users/{uid}/trees/{treeId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'addedAt', 'slot'])
        && request.resource.data.keys().hasAll(['name', 'addedAt', 'slot'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.addedAt == request.time
        && validSlot(request.resource.data.slot)
        && existsAfter(slotDoc(uid, request.resource.data.slot))
        && getAfter(slotDoc(uid, request.resource.data.slot)).data.treeId == treeId
        && existsAfter(memberDoc(treeId, request.auth.uid));
      // Entries made before slots existed get a slot once, and nothing else changes.
      allow update: if isSelf(uid)
        && !('slot' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slot'])
        && validSlot(request.resource.data.slot)
        && getAfter(slotDoc(uid, request.resource.data.slot)).data.treeId == treeId;
      allow delete: if isSelf(uid);
    }

    // Trees a person has asked to join and is waiting to hear back from.
    match /users/{uid}/pending/{treeId} {
      allow read, delete: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['treeName', 'requestedAt'])
        && request.resource.data.treeName is string
        && request.resource.data.treeName.size() <= 120
        && request.resource.data.requestedAt == request.time
        && existsAfter(/databases/$(database)/documents/trees/$(treeId)/joinRequests/$(uid));
      allow update: if false;
    }

    match /users/{uid}/slots/{slot} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && slot in ['1', '2', '3', '4', '5']
        && request.resource.data.keys().hasOnly(['treeId'])
        && request.resource.data.treeId is string
        && getAfter(/databases/$(database)/documents/users/$(uid)/trees/$(request.resource.data.treeId)).data.slot == int(slot);
      allow update: if false;
      // A slot is freed only when the tree it held leaves the list in the same step.
      allow delete: if isSelf(uid)
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/trees/$(resource.data.treeId));
    }

    // ---------- trees ----------

    function validTree(d) {
      return d.keys().hasOnly(['name', 'ownerUid', 'createdAt', 'settings'])
        && d.keys().hasAll(['name', 'ownerUid', 'createdAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 120
        && optMap(d, 'settings')
        && (!('settings' in d)
            || (d.settings.keys().hasOnly(['adminsCanInvite', 'participantsCanInvite', 'inviteDays'])
                && (!('inviteDays' in d.settings)
                    || (d.settings.inviteDays is int && d.settings.inviteDays >= 1 && d.settings.inviteDays <= 30))
                && (!('adminsCanInvite' in d.settings) || d.settings.adminsCanInvite is bool)
                && (!('participantsCanInvite' in d.settings) || d.settings.participantsCanInvite is bool)));
    }

    // What the manager has switched on for this tree (missing means the default).
    function treeSetting(treeId, key, fallback) {
      return get(/databases/$(database)/documents/trees/$(treeId)).data.get('settings', {}).get(key, fallback);
    }

    // Who may create an invitation, and for which role.
    function canInvite(treeId, role) {
      return isOwner(treeId)
        || (isReviewer(treeId) && treeSetting(treeId, 'adminsCanInvite', true) == true)
        || (canContribute(treeId) && role == 'contributor'
            && treeSetting(treeId, 'participantsCanInvite', false) == true);
    }

    function inviteDoc(treeId, code) {
      return /databases/$(database)/documents/trees/$(treeId)/invites/$(code);
    }

    function joinDoc(treeId, uid) {
      return /databases/$(database)/documents/trees/$(treeId)/joinRequests/$(uid);
    }

    match /trees/{treeId} {
      allow read: if isMember(treeId);

      // A tree and its owner membership must be created in the same batch.
      allow create: if signedIn()
        && validTree(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(memberDoc(treeId, request.auth.uid)).data.role == 'owner'
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/trees/$(treeId));

      // Only the manager changes the tree. The manager can also hand it to another member:
      // the new manager's role and the old one's step-down must happen in the same batch.
      allow update: if isOwner(treeId)
        && validTree(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.ownerUid == resource.data.ownerUid
            || (request.resource.data.ownerUid != request.auth.uid
                && resource.data.ownerUid == request.auth.uid
                && getAfter(memberDoc(treeId, request.resource.data.ownerUid)).data.role == 'owner'
                && getAfter(memberDoc(treeId, request.auth.uid)).data.role in ['reviewer', 'contributor']));

      // An admin can change the "participants can invite" switch, nothing else.
      allow update: if isReviewer(treeId)
        && validTree(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings'])
        && request.resource.data.get('settings', {}).diff(resource.data.get('settings', {}))
             .affectedKeys().hasOnly(['participantsCanInvite']);

      // Deleting a tree document does not delete its subcollections.
      // A full tree deletion is done by the client, collection by collection.
      allow delete: if isOwner(treeId);

      // ---------- members ----------

      function validMember(d) {
        return d.keys().hasOnly(['role', 'displayName', 'joinedAt', 'personId'])
          && d.keys().hasAll(['role', 'displayName', 'joinedAt'])
          && d.role in ['owner', 'reviewer', 'contributor', 'viewer']
          && d.displayName is string
          && d.displayName.size() <= 100
          && optString(d, 'personId', 100);
      }

      match /members/{memberUid} {
        // Nobody sees other people's roles. Each person reads only their own record;
        // the manager and admins see everyone, to manage them.
        allow read: if isSelf(memberUid) || isReviewer(treeId);

        // The creator of a tree becomes its owner (same batch as the tree).
        allow create: if memberUid == request.auth.uid
          && validMember(request.resource.data)
          && request.resource.data.role == 'owner'
          && request.resource.data.joinedAt == request.time
          && getAfter(/databases/$(database)/documents/trees/$(treeId)).data.ownerUid == request.auth.uid;

        // Someone joins only when an admin approves their join request, in the same batch,
        // and only in the role the invitation offered. Nobody else becomes a manager.
        allow create: if isReviewer(treeId)
          && memberUid != request.auth.uid
          && validMember(request.resource.data)
          && request.resource.data.role in ['reviewer', 'contributor']
          && request.resource.data.joinedAt == request.time
          && get(joinDoc(treeId, memberUid)).data.status == 'pending'
          && getAfter(joinDoc(treeId, memberUid)).data.status == 'approved'
          && request.resource.data.role == get(joinDoc(treeId, memberUid)).data.role
          // A replacement inherits the old member's role and place in the tree.
          && (!('replaces' in get(joinDoc(treeId, memberUid)).data)
              || (get(memberDoc(treeId, get(joinDoc(treeId, memberUid)).data.replaces)).data.role
                    == request.resource.data.role
                  && get(memberDoc(treeId, get(joinDoc(treeId, memberUid)).data.replaces)).data.get('personId', null)
                    == request.resource.data.get('personId', null)));

        // Manager and admins can make someone else an admin or a participant. The manager's
        // own role is never touched this way.
        allow update: if isReviewer(treeId)
          && memberUid != request.auth.uid
          && resource.data.role != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['reviewer', 'contributor', 'viewer'];

        // An admin can step down to participant.
        allow update: if isSelf(memberUid)
          && isMember(treeId)
          && myRole(treeId) == 'reviewer'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['contributor', 'viewer'];

        // Handing the tree over: the manager makes another member the manager, and steps
        // down, in one batch together with the change of the tree's ownerUid.
        allow update: if isOwner(treeId)
          && memberUid != request.auth.uid
          && resource.data.role in ['reviewer', 'contributor']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/trees/$(treeId)).data.ownerUid == memberUid
          && getAfter(memberDoc(treeId, request.auth.uid)).data.role in ['reviewer', 'contributor'];

        allow update: if isOwner(treeId)
          && memberUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['reviewer', 'contributor']
          && getAfter(/databases/$(database)/documents/trees/$(treeId)).data.ownerUid != request.auth.uid
          && getAfter(memberDoc(treeId,
               getAfter(/databases/$(database)/documents/trees/$(treeId)).data.ownerUid)).data.role == 'owner';

        // Manager and admins can remove others (never the manager). Anyone except the
        // manager can leave.
        allow delete: if (isReviewer(treeId) && memberUid != request.auth.uid && resource.data.role != 'owner')
          || (isSelf(memberUid) && isMember(treeId) && myRole(treeId) != 'owner');
      }

      // ---------- people ----------

      function validPerson(d) {
        return d.keys().hasOnly([
            'nameBn', 'nameEn', 'nickname', 'altNames', 'birth', 'birthOrder', 'death',
            'birthPlace', 'residence', 'deathPlace', 'occupation', 'bio',
            'photoMediaId', 'living', 'verification', 'publicContact',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && d.keys().hasAll(['createdBy', 'createdAt'])
          && optString(d, 'nameBn', 200)
          && optString(d, 'nameEn', 200)
          && optString(d, 'nickname', 200)
          && optList(d, 'altNames', 30)
          && optMap(d, 'birth')
          && (!('birthOrder' in d) || (d.birthOrder is int && d.birthOrder >= 1 && d.birthOrder <= 30))
          && optMap(d, 'death')
          && optString(d, 'birthPlace', 300)
          && optString(d, 'residence', 300)
          && optString(d, 'deathPlace', 300)
          && optString(d, 'occupation', 300)
          && optString(d, 'bio', 10000)
          && optString(d, 'photoMediaId', 100)
          && (!('publicContact' in d)
              || (d.publicContact is map
                  && d.publicContact.keys().hasOnly(['phone', 'facebook', 'email'])))
          && (!('living' in d) || d.living is bool)
          && (!('verification' in d)
              || d.verification in ['documented', 'recollection', 'estimated', 'disputed', 'unverified'])
          && optStamp(d);
      }

      match /people/{personId} {
        allow read: if isMember(treeId);

        // Only the manager and admins add people. A participant proposes it, and an admin
        // approves (which is when the person is written here).
        allow create: if isReviewer(treeId)
          && validPerson(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // Contributors change existing people through proposals, not directly.
        allow update: if isReviewer(treeId)
          && validPerson(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;

        // A member can show or hide their own contact details, and change nothing else.
        allow update: if isMember(treeId)
          && get(memberDoc(treeId, request.auth.uid)).data.get('personId', '') == personId
          && validPerson(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicContact', 'updatedAt']);

        allow delete: if isReviewer(treeId);

        // Phone, email and other contact details: owner and reviewers only.
        match /private/{docId} {
          allow read, write: if isReviewer(treeId);
        }
      }

      // ---------- invitations ----------
      // The invitation code is the document id: long and random, so it cannot be guessed.
      // Anyone signed in who has the link can read that one invitation, but nobody can list them
      // except the manager and admins.

      match /invites/{code} {
        allow get: if signedIn();
        allow list: if isReviewer(treeId);

        allow create: if request.resource.data.keys().hasOnly(
              ['role', 'treeName', 'createdBy', 'createdAt', 'expiresAt', 'replaces'])
          && request.resource.data.role in ['reviewer', 'contributor']
          && request.resource.data.treeName is string
          && request.resource.data.treeName.size() <= 120
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(treeSetting(treeId, 'inviteDays', 7) + 1, 'd')
          && ((!('replaces' in request.resource.data)
                && canInvite(treeId, request.resource.data.role))
              // A recovery invitation: for someone who lost their email. The new account takes
              // the place of the old member. Only the manager may replace an admin.
              || ('replaces' in request.resource.data
                && isReviewer(treeId)
                && request.resource.data.replaces is string
                && request.resource.data.replaces != request.auth.uid
                && get(memberDoc(treeId, request.resource.data.replaces)).data.role == request.resource.data.role
                && (isOwner(treeId) || request.resource.data.role == 'contributor')));

        // Used once, in the same batch as the join request that uses it.
        allow update: if signedIn()
          && !('usedBy' in resource.data)
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.usedAt == request.time
          && existsAfter(joinDoc(treeId, request.auth.uid));

        allow delete: if isReviewer(treeId) || (resource.data.createdBy == request.auth.uid && canContribute(treeId));
      }

      // ---------- join requests ----------
      // What a newcomer tells the admins so they can check who they are. Contact details here
      // are seen by the person and the admins only.

      function validJoin(d) {
        return d.keys().hasOnly([
            'displayName', 'fatherName', 'motherName', 'contact', 'contactOf',
            'inviteCode', 'role', 'status', 'createdAt', 'reviewedBy', 'reviewedAt', 'personId',
            'replaces'
          ])
          && optString(d, 'replaces', 100)
          && d.keys().hasAll(['displayName', 'inviteCode', 'role', 'status', 'createdAt'])
          && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 100
          && optString(d, 'fatherName', 100)
          && optString(d, 'motherName', 100)
          && (!('contactOf' in d) || d.contactOf in ['self', 'father', 'mother', 'other'])
          && (!('contact' in d)
              || (d.contact is map && d.contact.keys().hasOnly(['phone', 'facebook', 'email'])))
          && d.inviteCode is string
          && d.role in ['reviewer', 'contributor'];
      }

      match /joinRequests/{uid} {
        allow read: if isSelf(uid) || isReviewer(treeId);

        allow create: if isSelf(uid)
          && !isMember(treeId)
          && validJoin(request.resource.data)
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && !('reviewedBy' in request.resource.data)
          && get(inviteDoc(treeId, request.resource.data.inviteCode)).data.role == request.resource.data.role
          && !('usedBy' in get(inviteDoc(treeId, request.resource.data.inviteCode)).data)
          && get(inviteDoc(treeId, request.resource.data.inviteCode)).data.expiresAt > request.time
          && get(inviteDoc(treeId, request.resource.data.inviteCode)).data.get('replaces', null)
               == request.resource.data.get('replaces', null)
          && getAfter(inviteDoc(treeId, request.resource.data.inviteCode)).data.usedBy == request.auth.uid;

        // An admin decides. Approving also adds the member, in the same batch.
        allow update: if isReviewer(treeId)
          && uid != request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['status', 'reviewedBy', 'reviewedAt', 'personId'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && (request.resource.data.status == 'rejected' || existsAfter(memberDoc(treeId, uid)))
          // A recovery takes the old member out in the same batch: the old login loses access.
          && (request.resource.data.status == 'rejected'
              || !('replaces' in resource.data)
              || !existsAfter(memberDoc(treeId, resource.data.replaces)));

        allow delete: if isSelf(uid) || isReviewer(treeId);
      }

      // ---------- relationships ----------
      // type 'parent': personA is a parent of personB.

      function validRelationship(d) {
        return d.keys().hasOnly([
            'personA', 'personB', 'type', 'kind', 'status',
            'startDate', 'endDate', 'note', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && d.keys().hasAll(['personA', 'personB', 'type', 'createdBy', 'createdAt'])
          && d.personA is string
          && d.personB is string
          && d.personA != d.personB
          && d.type in ['parent', 'spouse', 'sibling', 'other']
          && (!('kind' in d) || d.kind in ['biological', 'adoptive', 'step', 'foster', 'unknown'])
          && (!('status' in d) || d.status in ['confirmed', 'uncertain', 'disputed'])
          && optMap(d, 'startDate')
          && optMap(d, 'endDate')
          && optString(d, 'note', 2000)
          && optStamp(d);
      }

      match /relationships/{relId} {
        allow read: if isMember(treeId);

        allow create: if isReviewer(treeId)
          && validRelationship(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update: if isReviewer(treeId)
          && validRelationship(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isReviewer(treeId);
      }

      // ---------- memories (stories) ----------

      function validMemory(d) {
        return d.keys().hasOnly([
            'title', 'body', 'authorUid', 'authorName', 'personIds', 'mediaIds', 'date',
            'place', 'tags', 'sources', 'status', 'createdAt', 'updatedAt'
          ])
          && d.keys().hasAll(['body', 'authorUid', 'status', 'createdAt'])
          && d.status in ['published', 'pending']
          && optString(d, 'authorName', 100)
          && d.body is string
          && d.body.size() <= 50000
          && optString(d, 'title', 300)
          && optList(d, 'personIds', 100)
          && optList(d, 'mediaIds', 100)
          && optMap(d, 'date')
          && optString(d, 'place', 300)
          && optList(d, 'tags', 30)
          && optList(d, 'sources', 30)
          && optStamp(d);
      }

      // A participant's story waits for an admin ("pending") and is seen only by its author and
      // the admins until approved. Admins publish directly.
      match /memories/{memoryId} {
        allow read: if isMember(treeId)
          && (resource.data.status == 'published'
              || isReviewer(treeId)
              || resource.data.authorUid == request.auth.uid);

        allow create: if canContribute(treeId)
          && validMemory(request.resource.data)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (request.resource.data.status == 'pending' || isReviewer(treeId));

        // Admins edit and approve. An author's own edit goes back to waiting for approval.
        allow update: if canContribute(treeId)
          && validMemory(request.resource.data)
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.createdAt == resource.data.createdAt
          && (isReviewer(treeId)
              || (resource.data.authorUid == request.auth.uid && request.resource.data.status == 'pending'));

        allow delete: if canContribute(treeId)
          && (isReviewer(treeId)
              || (resource.data.authorUid == request.auth.uid && resource.data.status == 'pending'));
      }

      // ---------- media records (metadata only; files are stored elsewhere) ----------

      function validMedia(d) {
        return d.keys().hasOnly([
            'storagePath', 'mediaType', 'caption', 'description', 'date',
            'place', 'occasion', 'photographer', 'taggedPeople', 'storyIds',
            'sizeBytes', 'uploadedBy', 'createdAt', 'updatedAt'
          ])
          && d.keys().hasAll(['storagePath', 'mediaType', 'uploadedBy', 'createdAt'])
          && d.storagePath is string
          && d.storagePath.size() <= 500
          && d.mediaType in ['image', 'audio', 'document']
          && optString(d, 'caption', 1000)
          && optString(d, 'description', 5000)
          && optMap(d, 'date')
          && optString(d, 'place', 300)
          && optString(d, 'occasion', 300)
          && optString(d, 'photographer', 200)
          && optList(d, 'taggedPeople', 100)
          && optList(d, 'storyIds', 100)
          && optStamp(d);
      }

      match /media/{mediaId} {
        allow read: if isMember(treeId);

        allow create: if canContribute(treeId)
          && validMedia(request.resource.data)
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update: if canContribute(treeId)
          && (resource.data.uploadedBy == request.auth.uid || isReviewer(treeId))
          && validMedia(request.resource.data)
          && request.resource.data.uploadedBy == resource.data.uploadedBy
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isReviewer(treeId);
      }

      // ---------- edit proposals, comments and votes ----------

      // A participant's suggestion to add, change or remove a person or a relationship.
      // `kind` says which, `payload` holds the details. The admin team sees every suggestion
      // and its author; a participant sees only their own.
      match /reports/{reportId} {
        allow read: if isReviewer(treeId)
          || (isMember(treeId) && resource.data.reporterUid == request.auth.uid);

        // Any member can write to the admin team. The sender is known to the admins.
        allow create: if isMember(treeId)
          && request.resource.data.keys().hasOnly(
               ['text', 'category', 'reporterUid', 'reporterName', 'status', 'createdAt'])
          && request.resource.data.keys().hasAll(['text', 'category', 'reporterUid', 'status', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.category in ['problem', 'contact']
          && optString(request.resource.data, 'reporterName', 100)
          && request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time;

        // Admins answer as "Admin team": no admin id is stored on the report.
        allow update: if isReviewer(treeId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reply', 'updatedAt'])
          && request.resource.data.status in ['open', 'seen', 'solved']
          && optString(request.resource.data, 'reply', 2000)
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      match /proposals/{proposalId} {
        allow read: if isReviewer(treeId) || (isMember(treeId) && resource.data.proposedBy == request.auth.uid);

        allow create: if canContribute(treeId)
          && request.resource.data.keys().hasOnly([
               'targetType', 'targetId', 'field', 'oldValue', 'newValue',
               'reason', 'evidenceIds', 'status', 'proposedBy', 'createdAt',
               'kind', 'payload', 'proposerName', 'targetName'
             ])
          && request.resource.data.keys().hasAll(
               ['targetType', 'targetId', 'reason', 'status', 'proposedBy', 'createdAt'])
          && (!('kind' in request.resource.data)
              || request.resource.data.kind in
                   ['addPerson', 'editPerson', 'deletePerson', 'addRelation', 'removeRelation'])
          && (!('payload' in request.resource.data)
              || (request.resource.data.payload is map && request.resource.data.payload.keys().size() <= 40))
          && optString(request.resource.data, 'proposerName', 100)
          && optString(request.resource.data, 'targetName', 200)
          && request.resource.data.targetType in ['person', 'relationship', 'memory', 'media']
          && request.resource.data.targetId is string
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 5000
          && request.resource.data.status == 'pending'
          && request.resource.data.proposedBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // Only reviewers decide, and only the decision fields can change.
        // A non-owner reviewer cannot decide their own proposal.
        allow update: if isReviewer(treeId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'decision', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.status in ['under_review', 'approved', 'rejected', 'more_info']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && optString(request.resource.data, 'decision', 2000)
          && (resource.data.proposedBy != request.auth.uid || myRole(treeId) == 'owner');

        // Proposals are never deleted: they are part of the permanent history.
        allow delete: if false;

        match /comments/{commentId} {
          allow read: if isMember(treeId);
          allow create: if canContribute(treeId)
            && request.resource.data.keys().hasOnly(['authorUid', 'text', 'createdAt'])
            && request.resource.data.keys().hasAll(['authorUid', 'text', 'createdAt'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 5000
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        // One vote per person, document id = voter's uid.
        // Votes are community opinion only; a reviewer still decides.
        match /votes/{voterUid} {
          allow read: if isMember(treeId);
          allow create, update: if canContribute(treeId)
            && voterUid == request.auth.uid
            && request.resource.data.keys().hasOnly(['value', 'votedAt'])
            && request.resource.data.keys().hasAll(['value', 'votedAt'])
            && request.resource.data.value in ['agree', 'disagree', 'need_info']
            && request.resource.data.votedAt == request.time;
          allow delete: if isSelf(voterUid) && canContribute(treeId);
        }
      }

      // ---------- audit log (append-only) ----------

      match /audit/{entryId} {
        allow read: if isMember(treeId);
        allow create: if canContribute(treeId)
          && request.resource.data.keys().hasOnly([
               'action', 'targetType', 'targetId', 'before', 'after',
               'reason', 'actorUid', 'createdAt'
             ])
          && request.resource.data.keys().hasAll(
               ['action', 'targetType', 'targetId', 'actorUid', 'createdAt'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Everything else, including anything not yet built (invitations,
    // notifications, tree matching), is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
